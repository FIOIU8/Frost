root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Markdown 的行尾双空格是换行语法，不能裁掉
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.{kt,kts}]
# 与 ktlint 默认规则保持一致
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Compose 约定：@Composable 函数用 PascalCase（ktlint 默认要求 camelCase，需显式放行）
ktlint_function_naming_ignore_when_annotated_with = Composable
